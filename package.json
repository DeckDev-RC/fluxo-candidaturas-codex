{
  "name": "fluxo-monorepo",
  "version": "1.4.1",
  "private": true,
  "description": "Monorepo open source do Fluxo para candidaturas assistidas",
  "license": "Apache-2.0",
  "author": "DeckDev-RC",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeckDev-RC/fluxo-candidaturas-codex.git"
  },
  "workspaces": [
    "apps/desktop",
    "packages/powershell"
  ],
  "scripts": {
    "start": "npm run start:desktop",
    "start:desktop": "npm --workspace @deckdev-rc/fluxo-desktop start",
    "start:web": "npm --workspace @deckdev-rc/fluxo-desktop run start:web",
    "test": "npm run test:app && npm run test:powershell",
    "test:app": "npm --workspace @deckdev-rc/fluxo-desktop test",
    "test:powershell": "npm --workspace @deckdev-rc/fluxo-powershell test",
    "test:desktop": "npm --workspace @deckdev-rc/fluxo-desktop run test:desktop",
    "test:desktop:e2e": "npm --workspace @deckdev-rc/fluxo-desktop run test:desktop:e2e",
    "test:e2e": "npm --workspace @deckdev-rc/fluxo-desktop run test:e2e",
    "test:coverage": "npm --workspace @deckdev-rc/fluxo-desktop run test:coverage",
    "browser:install": "npm --workspace @deckdev-rc/fluxo-desktop run browser:install",
    "diagnose": "npm --workspace @deckdev-rc/fluxo-desktop run diagnose",
    "build:dir": "npm --workspace @deckdev-rc/fluxo-desktop run build:dir",
    "build": "npm --workspace @deckdev-rc/fluxo-desktop run build"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
